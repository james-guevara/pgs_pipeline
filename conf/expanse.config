/*
 * SDSC Expanse site adapter. Keep scheduler, account, and filesystem details
 * out of the portable workflow; override them in another site config as needed.
 */
process {
    executor = 'slurm'
    queue = 'ind-shared'
    clusterOptions = '--account=ddp195 --ntasks=1 --nodes=1'
    beforeScript = 'module load cpu/0.17.3b singularitypro/4.1.2'
}

workDir = params.shared_work_dir

singularity {
    enabled = true
    autoMounts = true
    runOptions = '-B /expanse/projects/sebat1'
}

apptainer.enabled = false
