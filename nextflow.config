manifest {
    name = 'pgs_pipeline'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    container = 'quay.io/biocontainers/plink2:2.0.0a.6.9--h9948957_0'
    // The non-slim image includes procps, required by Nextflow task metrics.
    python_container = 'python:3.11.16-bookworm'
    outdir = 'results'
    report_dir = 'pipeline_info'
    aws_queue = null
    aws_region = 'us-west-2'
    aws_work_dir = null
    fsx_mount = '/fsx'
    shared_work_dir = null
}

process {
    container = params.container
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 2
    maxErrors = '-1'

    withLabel: small {
        cpus = 4
        memory = 16.GB
        time = 2.h
    }
    withLabel: scoring {
        cpus = 4
        memory = 8.GB
        time = 2.h
    }
    withLabel: large {
        cpus = 16
        memory = 64.GB
        time = 6.h
    }
}

profiles {
    local {
        process.executor = 'local'
        docker.enabled = true
    }

    awsbatch {
        process.executor = 'awsbatch'
        process.queue = params.aws_queue
        workDir = params.aws_work_dir
        aws.region = params.aws_region
        aws.batch.cliPath = '/opt/nxf-aws-cli/bin/aws'
    }

    awsbatch_fsx {
        process.executor = 'awsbatch'
        process.queue = params.aws_queue
        workDir = params.aws_work_dir
        aws.region = params.aws_region
        aws.batch.cliPath = '/opt/nxf-aws-cli/bin/aws'
        aws.batch.volumes = ["${params.fsx_mount}:${params.fsx_mount}"]
    }

    awsbatch_fsx_smoke {
        process {
            executor = 'awsbatch'
            queue = params.aws_queue
            withLabel: small {
                cpus = 4
                memory = 16.GB
                time = 2.h
            }
            withLabel: scoring {
                cpus = 4
                memory = 8.GB
                time = 2.h
            }
            withLabel: large {
                cpus = 4
                memory = 16.GB
                time = 6.h
            }
        }
        workDir = params.aws_work_dir
        aws.region = params.aws_region
        aws.batch.cliPath = '/opt/nxf-aws-cli/bin/aws'
        aws.batch.volumes = ["${params.fsx_mount}:${params.fsx_mount}"]
    }

    singularity {
        singularity.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        workDir = params.shared_work_dir
        apptainer.enabled = true
    }
}

timeline {
    enabled = true
    file = "${params.report_dir}/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.report_dir}/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.report_dir}/trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.report_dir}/dag.html"
    overwrite = true
}
